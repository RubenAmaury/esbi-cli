{
  "schemaVersion": "0.1.0",
  "name": "esbi-cli: YouTube",
  "behavior": "create",
  "noteNameFormat": "{{title|safe_name}}",
  "path": "inbox",
  "triggers": ["https://www.youtube.com/watch"],
  "properties": [
    { "name": "title", "value": "{{title}}", "type": "text" },
    { "name": "source", "value": "{{url}}", "type": "text" },
    { "name": "channel", "value": "{{author}}", "type": "text" },
    { "name": "published", "value": "{{published}}", "type": "text" },
    { "name": "duration", "value": "{{schema:@VideoObject:duration|replace:\"PT\":\"\"}}", "type": "text" },
    { "name": "kind", "value": "video", "type": "text" }
  ],
  "noteContentFormat": "# {{title}}\n\n{{description}}\n\n## Transcript\n\n{{transcript}}",
  "context": ""
}
